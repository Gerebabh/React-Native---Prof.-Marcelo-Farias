{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "jsx": "react-jsx"
  },
  "include": ["app/**/*.js", "components/**/*.js", "constants/**/*.js", "hooks/**/*.js", "services/**/*.js", "store/**/*.js"],
  "exclude": ["node_modules", "dist-android", "dist-check"]
}
